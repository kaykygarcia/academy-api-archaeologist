{
  "name": "api-archaeologist",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @api-archaeologist/web dev",
    "build": "pnpm --filter @api-archaeologist/web build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @api-archaeologist/web test:e2e",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
